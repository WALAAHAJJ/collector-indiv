# Copier ce fichier en .env avant de lancer `docker compose up`.
# Le fichier .env n'est jamais versionné : il contient les secrets de votre machine.

# Base de données (les deux bases PostgreSQL utilisent le même compte)
POSTGRES_DB=collector_collection
POSTGRES_USER=collector
POSTGRES_PASSWORD=change-me

# RabbitMQ : messagerie entre les services (événements d'annonces).
# Interface d'administration : http://localhost:15672
RABBITMQ_USER=collector
RABBITMQ_PASSWORD=change-me

# Keycloak : serveur d'identité (comptes, connexion, rôles).
# Console d'administration : http://localhost:8180 (compte ci-dessous, domaine « master »).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Clé de signature des jetons JWT (HS256), partagée par user-service et collection-service.
# 32 octets minimum, encodés en base64. Pour en générer une : openssl rand -base64 32
# La valeur ci-dessous est réservée au développement local.
JWT_SECRET=Zm9yLWxvY2FsLWRldmVsb3BtZW50LW9ubHktc2VjcmV0LTIwMjY=

# Compte administrateur du site, créé dans Keycloak au premier démarrage (et dans le user-service tant qu'il existe).
# ADMIN_PASSWORD est obligatoire pour Keycloak. 8 caractères minimum.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@collector.local
ADMIN_PASSWORD=
